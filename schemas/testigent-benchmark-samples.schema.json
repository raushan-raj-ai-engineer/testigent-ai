{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testigent.ai/schemas/testigent-benchmark-samples.schema.json",
  "title": "TestigentAI comparative benchmark input",
  "type": "object",
  "required": ["samples"],
  "properties": {
    "templateOnly": { "type": "boolean" },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "application", "datasetVersion", "metric", "unit", "baselineLabel", "baselineValue", "testigentValue", "environmentDescription", "methodology", "evidenceRef"],
        "properties": {
          "schemaVersion": { "const": 1 },
          "id": { "type": "string", "minLength": 1 },
          "application": { "type": "string", "minLength": 1 },
          "datasetVersion": { "type": "string", "minLength": 1 },
          "metric": { "enum": ["authoring-minutes", "triage-minutes", "ci-wall-minutes", "migration-minutes", "report-completeness-percent", "ai-cost-usd"] },
          "unit": { "enum": ["minutes", "percent", "usd"] },
          "baselineLabel": { "type": "string", "minLength": 1 },
          "baselineValue": { "type": "number", "minimum": 0 },
          "testigentValue": { "type": "number", "minimum": 0 },
          "productVersion": { "type": "string" },
          "commit": { "type": "string" },
          "runtime": { "type": "string" },
          "platform": { "type": "string" },
          "environmentDescription": { "type": "string", "minLength": 1 },
          "methodology": { "type": "string", "minLength": 1 },
          "evidenceRef": { "type": "string", "minLength": 1 },
          "exclusions": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
