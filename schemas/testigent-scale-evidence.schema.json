{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testigent.ai/schemas/testigent-scale-evidence.schema.json",
  "title": "TestigentAI measured scale execution evidence",
  "type": "object",
  "required": ["id", "application", "environment", "datasetVersion", "selection", "caseCount", "executedCases", "duplicateCases", "droppedCases", "workers", "shards", "wallClockMs", "shardDurationsMs", "environmentDescription", "methodology", "evidenceRef"],
  "properties": {
    "templateOnly": { "type": "boolean" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "application": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "selection": { "type": "string", "minLength": 1 },
    "profile": { "type": "string" },
    "lane": { "type": "string" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "executedCases": { "type": "integer", "minimum": 0 },
    "duplicateCases": { "type": "integer", "minimum": 0 },
    "droppedCases": { "type": "integer", "minimum": 0 },
    "workers": { "type": "integer", "minimum": 1 },
    "shards": { "type": "integer", "minimum": 1 },
    "wallClockMs": { "type": "number", "minimum": 0 },
    "shardDurationsMs": { "type": "array", "items": { "type": "number", "minimum": 0 } },
    "reportMergeMs": { "type": "number", "minimum": 0 },
    "peakRssMb": { "type": "number", "minimum": 0 },
    "productVersion": { "type": "string" },
    "commit": { "type": "string" },
    "runtime": { "type": "string" },
    "platform": { "type": "string" },
    "environmentDescription": { "type": "string", "minLength": 1 },
    "methodology": { "type": "string", "minLength": 1 },
    "evidenceRef": { "type": "string", "minLength": 1 },
    "failures": { "type": "array", "items": { "type": "string" } },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "synthetic": { "type": "boolean" }
  },
  "additionalProperties": false
}
