```env
# =========================================================
# TESTIGENTAI - ENVIRONMENT TEMPLATE
# =========================================================
#
# Copy this file before local use:
#
#   cp .env.example .env
#
# Never commit the real .env file.
#
# Recommended:
#   - Keep secrets only in local .env or CI secret manager.
#   - Keep AI disabled unless explicitly required.
#   - Select only the provider you actually want to use.
#   - Keep project-specific application settings under:
#       projects/<project>/config/<env>.json
#
# =========================================================


# =========================================================
# 1. PROJECT / ENVIRONMENT
# =========================================================
#
# APP identifies the project folder:
#
#   projects/demo
#   projects/sdet-practice
#   projects/project2
#
# Local developers should normally select this once with:
#   npm run qa:use -- <project> <environment>
# APP/ENV are primarily explicit CI/one-off overrides. Leave them blank here.
#
# ENV loads:
#   projects/<APP>/config/<ENV>.json
#
# Examples:
#   ENV=qa
#   ENV=uat
#   ENV=prod
#
APP=
ENV=


# =========================================================
# 2. PLAYWRIGHT EXECUTION
# =========================================================
#
# Most users can leave these defaults unchanged.
#

# Overall test timeout in milliseconds.
TEST_TIMEOUT_MS=60000

# Playwright expect timeout.
EXPECT_TIMEOUT_MS=10000

# Action timeout.
ACTION_TIMEOUT_MS=15000

# Navigation timeout.
NAVIGATION_TIMEOUT_MS=30000

# Optional worker override.
# Leave blank to let Playwright/framework decide.
#
# Examples:
#   PW_WORKERS=2
#   PW_WORKERS=4
#
PW_WORKERS=

# Optional retry override.
#
# Example:
#   PW_RETRIES=1
#
PW_RETRIES=

# Optional maximum failures in CI.
PW_MAX_FAILURES=50

# Optional Playwright policy overrides. Organization defaults live in
# config/organization.json; projects/environments override only when necessary.
# Comma-separated: chromium,firefox,webkit
PW_BROWSERS=
PW_TRACE=
PW_SCREENSHOT=
PW_VIDEO=
VISUAL_MAX_DIFF_RATIO=
PW_IGNORE_HTTPS_ERRORS=
PW_WS_TIMEOUT_MS=


# =========================================================
# 3. AUTHENTICATION / STORAGE STATE
# =========================================================
#
# Normally the project config controls auth strategy.
#
# Example project config:
#
#   "auth": {
#     "strategy": "storageState",
#     "storageStatePath": ".auth/project.qa.json",
#     "required": true
#   }
#
# PW_STORAGE_STATE is only needed when you explicitly want
# to override the configured project storage-state path.
#
PW_STORAGE_STATE=

# Optional standard inputs for a project-owned non-interactive auth provider.
# Leave unused values blank. Private values belong only in local .env / CI secret stores.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_REFRESH_TOKEN=

# Required only when capturing application auth through:
#
#   APP=<project> ENV=qa \
#   APPLICATION_EXPLORATION_ENABLED=true \
#   npm run app:auth
#
APPLICATION_EXPLORATION_ENABLED=false


# =========================================================
# 4. DATABASE
# =========================================================
#
# Supported:
#   none
#   postgres
#   mysql
#   mssql
#
# Database type is owned exclusively by projects/<project>/config/<env>.json.
# This prevents one customer's machine/CI DB settings from activating database tests in another project.
# Configure only secret connection values here when the selected project enables a DB capability.
#
# Example PostgreSQL:
#
#   # project config: capabilities.database.type = postgres
#   DB_HOST=localhost
#   DB_PORT=5432
#   DB_NAME=automation
#   DB_USER=automation
#   DB_PASSWORD=<secret>
#   DB_SSL=false
#
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false


# =========================================================
# 5. SELF-HEALING
# =========================================================
#
# Supported modes:
#
#   off
#       No healing.
#
#   suggest
#       Reviewed source-controlled deterministic fallbacks may execute.
#       Validated cache / AI recovery remains non-automatic.
#
#   runtime
#       Deterministic fallbacks, semantically validated cache and explicitly
#       configured AI recovery may be used at runtime.
#
# Recommended normal/default:
#
#   HEALING_MODE=suggest
#
HEALING_MODE=suggest

# Minimum confidence required before accepting an AI-assisted
# locator candidate.
#
HEALING_MIN_CONFIDENCE=0.95

# Semantic post-condition polling for healed actions. Page Objects may override
# these per action when a specific business transition needs a different SLA.
HEALING_POSTCONDITION_TIMEOUT_MS=5000
HEALING_POSTCONDITION_INTERVAL_MS=100

# Enables AI only as the final healing stage.
#
# Healing sequence:
#
#   Primary locator
#     -> deterministic fallbacks
#     -> validated healing cache
#     -> lazy AI gateway creation only if still unresolved
#     -> configured AI provider/provider chain
#     -> deterministic locator safety validation
#     -> perform action
#     -> semantic business post-condition
#     -> runtime/suggest policy
#     -> cache only semantically validated AI recovery
#
HEALING_AI_ENABLED=false

# Test-selection safety guard. Ordinary/custom runs deny @ai by default.
# Dedicated AI scripts/CI lanes and `test:projects -- --include-ai` set this explicitly.
# Leave false for normal deterministic execution.
ALLOW_AI_TESTS=false


# =========================================================
# 6. AI CORE
# =========================================================
#
# AI is completely opt-in.
#
# The framework does NOT force Ollama, Gemini, OpenAI,
# Azure OpenAI, or any other provider.
#
AI_ENABLED=false


# =========================================================
# 7. AI PROVIDER MODE
# =========================================================
#
# Supported modes:
#
#   single
#       Use exactly one explicitly configured provider.
#
#   failover
#       Use providers in AI_PROVIDER_ORDER exactly as listed.
#
# Recommended default:
#
AI_PROVIDER_MODE=single


# =========================================================
# 8. SINGLE-PROVIDER SELECTION
# =========================================================
#
# Required when:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#
# Supported values:
#
#   ollama
#   gemini
#   openai
#   azure-openai
#   anthropic
#   openai-compatible
#   http
#
# Examples:
#
#   AI_PROVIDER=gemini
#   AI_PROVIDER=ollama
#   AI_PROVIDER=openai
#
AI_PROVIDER=


# =========================================================
# 9. FAILOVER PROVIDER ORDER
# =========================================================
#
# Used only when:
#
#   AI_PROVIDER_MODE=failover
#
# Order is respected exactly.
#
# Examples:
#
#   AI_PROVIDER_ORDER=ollama,gemini
#
#   AI_PROVIDER_ORDER=gemini,openai
#
#   AI_PROVIDER_ORDER=azure-openai,gemini
#
#   AI_PROVIDER_ORDER=ollama,gemini,openai
#
# Every provider listed here must be fully configured.
#
AI_PROVIDER_ORDER=


# =========================================================
# 10. CLOUD AI EGRESS SAFETY
# =========================================================
#
# External/cloud providers require explicit approval before
# application/test evidence can be sent outside the machine.
#
# Required for:
#
#   gemini
#   openai
#   azure-openai
#   anthropic
#
# Local Ollama does not require this.
#
AI_ALLOW_CLOUD_EGRESS=false


# =========================================================
# 11. AI RUNTIME LIMITS
# =========================================================
#
# Maximum AI calls allowed during one test.
#
AI_MAX_CALLS_PER_TEST=2

# Provider request timeout in milliseconds.
AI_TIMEOUT_MS=30000


# =========================================================
# 12. AI OBSERVABILITY / AUDIT
# =========================================================
#
# Safe runtime metadata can be recorded, such as:
#
#   provider
#   model
#   purpose
#   result/status
#   latency
#
# The framework should NOT persist:
#
#   API keys
#   full prompts
#   raw secrets
#   sensitive authentication values
#
AI_AUDIT_ENABLED=true

# Print provider/model/status/latency information in runtime logs.
AI_RUNTIME_LOGGING=true


# =========================================================
# 13. OLLAMA - LOCAL AI
# =========================================================
#
# Example single-provider configuration:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=ollama
#
# Ollama must be running locally.
#
# Example:
#
#   ollama serve
#   ollama pull llama3.2
#
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional tuning.
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=500


# =========================================================
# 14. GOOGLE GEMINI
# =========================================================
#
# Example:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=gemini
#   AI_ALLOW_CLOUD_EGRESS=true
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://generativelanguage.googleapis.com
#   GEMINI_API_KEY=<secret>
#   GEMINI_MODEL=gemini-3.8-flash
#
# Never commit the real API key.
#
GEMINI_API_KEY=

# Example model currently used in our framework testing:
GEMINI_MODEL=gemini-3.8-flash

GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# =========================================================
# 15. OPENAI
# =========================================================
#
# Example:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=openai
#   AI_ALLOW_CLOUD_EGRESS=true
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://api.openai.com
#   OPENAI_API_KEY=<secret>
#   OPENAI_MODEL=<approved-model>
#
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1


# =========================================================
# 16. AZURE OPENAI
# =========================================================
#
# Example:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=azure-openai
#   AI_ALLOW_CLOUD_EGRESS=true
#
#   AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://<resource>.openai.azure.com
#   AZURE_OPENAI_API_KEY=<secret>
#   AZURE_OPENAI_MODEL=<deployment/model>
#
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=


# =========================================================
# 17. ANTHROPIC CLAUDE
# =========================================================
#
# Example:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=anthropic
#   AI_ALLOW_CLOUD_EGRESS=true
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://api.anthropic.com
#
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional max output tokens.
ANTHROPIC_MAX_TOKENS=800


# =========================================================
# 18. OPENAI-COMPATIBLE PROVIDER / ENTERPRISE GATEWAY
# =========================================================
#
# Use this when your organization provides an approved
# OpenAI-compatible endpoint.
#
# Example:
#
#   AI_PROVIDER=openai-compatible
#
#   AI_COMPAT_BASE_URL=https://company-ai.example.com/v1
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://company-ai.example.com
#   AI_COMPAT_API_KEY=<secret>
#   AI_COMPAT_MODEL=company-model
#
AI_COMPAT_BASE_URL=
AI_COMPAT_API_KEY=
AI_COMPAT_MODEL=

# Supported examples:
#   json_schema
#   json_object
#   prompt
#
AI_COMPAT_STRUCTURED_MODE=json_schema


# =========================================================
# 19. GENERIC ORGANIZATION HTTP AI GATEWAY
# =========================================================
#
# Use only when the organization exposes a custom approved
# HTTP AI service that is not OpenAI-compatible.
#
AI_ENDPOINT=
AI_API_KEY=
AI_MODEL=


# =========================================================
# 20. BROWSER / DEBUG LOGGING
# =========================================================
#
# Enable only during investigation because verbose browser
# output can create noisy logs.
#
VERBOSE_BROWSER_LOGS=false


# =========================================================
# 21. PLAYWRIGHT TEST AGENTS
# =========================================================
#
# Supported developer-agent loops:
#
#   vscode
#   codex
#   claude
#   opencode
#
# Example:
#
#   PLAYWRIGHT_AGENT_LOOP=vscode
#   npm run agents:init
#
PLAYWRIGHT_AGENT_LOOP=vscode


# =========================================================
# 22. TEST AUTHORING PRODUCTIVITY METRICS
# =========================================================
#
# Enables measurement of AI/agent-assisted authoring duration.
#
AUTHORING_PRODUCTIVITY_ENABLED=true

# Optional agreed team baseline.
#
# Example:
#
#   AUTHORING_MANUAL_BASELINE_MINUTES=120
#
# Do not populate unless the team has agreed on a realistic
# comparison baseline.
#
AUTHORING_MANUAL_BASELINE_MINUTES=


# =========================================================
# 23. PLAYWRIGHT MCP
# =========================================================
#
# MCP is optional.
#
# Used for browser exploration / agent-assisted workflows.
#
PLAYWRIGHT_MCP_ISOLATED=true

# false = headed browser
# true  = headless browser
#
PLAYWRIGHT_MCP_HEADLESS=false

# Optional local MCP server port.
PLAYWRIGHT_MCP_PORT=8931

# stdout is recommended for local tooling.
PLAYWRIGHT_MCP_OUTPUT_MODE=stdout

# Optional semicolon-separated trusted origins.
#
# Example:
#
#   PLAYWRIGHT_MCP_ALLOWED_ORIGINS=https://qa.example.com;https://api.qa.example.com
#
PLAYWRIGHT_MCP_ALLOWED_ORIGINS=


# =========================================================
# 24. REPORTING / ARTIFACT NOTES
# =========================================================
#
# Reports are generated automatically under:
#
#   reports/<APP>/
#
# Examples:
#
#   reports/demo/playwright-html/
#   reports/demo/business/
#   reports/demo/ai/ai-audit.jsonl
#
# No additional environment values are required for normal
# local report generation.


# =========================================================
# 25. EMAIL / SMTP - OPTIONAL
# =========================================================
#
# Configure only if actual email sending is enabled.
#
# For normal report preview, SMTP is not required.
#
# Example:
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=<account>
#   SMTP_PASSWORD=<app-password-or-secret>
#   MAIL_FROM=<sender>
#   MAIL_TO=<recipient>
#
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=


# =========================================================
# 26. EXTERNAL CONNECTORS - OPTIONAL
# =========================================================
#
# Jira / Azure Boards / GitHub Issues integrations are optional.
# Configure only when the project needs requirement retrieval
# or execution-result write-back.
#
# Keep tokens/passwords in local .env or CI secret manager.
# Detailed examples are maintained under:
#
#   config/examples/connectors.env.example
#


# =========================================================
# 27. CI/CD EXAMPLE
# =========================================================
#
# CI should normally inject secrets rather than store them
# in repository files.
#
# Example Gemini CI variables:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=gemini
#   AI_ALLOW_CLOUD_EGRESS=true
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://generativelanguage.googleapis.com
#   GEMINI_MODEL=gemini-3.8-flash
#   GEMINI_API_KEY=<CI SECRET>
#
# Example local Ollama:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=single
#   AI_PROVIDER=ollama
#   OLLAMA_MODEL=llama3.2
#
# Example explicit failover:
#
#   AI_ENABLED=true
#   AI_PROVIDER_MODE=failover
#   AI_PROVIDER_ORDER=ollama,gemini
#   AI_ALLOW_CLOUD_EGRESS=true
#   AI_ALLOWED_EXTERNAL_ORIGINS=https://generativelanguage.googleapis.com
#
# There is deliberately NO automatic hidden provider fallback.


# =========================================================
# 28. COMMON COMMANDS FOR NEW USERS
# =========================================================
#
# Install:
#
#   npm ci
#   npx playwright install chromium
#
# Validate framework:
#
#   npm run validate:final
#
# List projects:
#
#   npm run project:list
#
# Run selected project:
#
#   APP=demo ENV=qa \
#   npm run test:project -- --project=chromium
#
# Check AI provider:
#
#   npm run ai:check
#
# Test configured AI healing:
#
#   npm run test:ai-healing
#
# Initialize Playwright Test Agents:
#
#   npm run agents:init
#
# Create a new project:
#
#   npm run project:new -- project2
#
# Capture auth:
#
#   APP=project2 \
#   ENV=qa \
#   APPLICATION_EXPLORATION_ENABLED=true \
#   npm run app:auth
#
# =========================================================
```

# TESTIGENTAI_AI_CI_ROBUST_SETTINGS
# Non-secret AI/CI settings. Keep real API keys only in local .env or CI Secrets.
AI_MAX_CALLS_PER_TEST=2
AI_PROVIDER_GENERATION_CHECK=true
AI_HEALING_SNAPSHOT_MAX_CHARS=6000
GEMINI_THINKING_LEVEL=low

# TESTIGENTAI_AI_RETRY_SETTINGS
# Bounded transient-provider retry policy for CI reliability.
AI_TOTAL_TIMEOUT_MS=90000
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=8000
AI_RETRY_JITTER_MS=250
AI_RETRY_ON_TIMEOUT=true

# Source-healing maintenance candidate threshold (runtime recoveries).
HEALING_MAINTENANCE_MIN_OCCURRENCES=3

# =========================================================
# 25. REVIEW-HARDENED DATA / EVIDENCE / RECOVERY POLICIES
# =========================================================
# Free-text sanitizer. "standard" masks common PII-like values (for example email/card-like text).
REDACTION_PII_MODE=standard
# Optional JSON array of additional regex source strings, for example ["CUSTOM_SECRET_[A-Z0-9]+"]
REDACTION_EXTRA_PATTERNS=[]

# Secure-by-default visual evidence. "masked" disables automatic trace/video/screenshot capture
# and uses framework-managed masked failure screenshots. "off" excludes visual evidence entirely.
# "standard" is only allowed with EVIDENCE_ALLOW_UNMASKED_VISUALS=true for synthetic/non-sensitive runs.
EVIDENCE_VISUAL_POLICY=masked
EVIDENCE_ALLOW_UNMASKED_VISUALS=false
# JSON array of extra CSS selectors to mask in framework-managed screenshots.
EVIDENCE_MASK_SELECTORS=[]
# Local generated report/result retention in days. 0 disables automatic local pruning. CI retention is configured in CI.
EVIDENCE_RETENTION_DAYS=14

# AI egress is evaluated from the resolved destination URL for every adapter and redirect.
# Loopback is allowed by default; private/custom origins must be explicitly approved.
AI_ALLOW_LOOPBACK_EGRESS=true
AI_ALLOWED_PRIVATE_ORIGINS=
AI_ALLOWED_EXTERNAL_ORIGINS=
AI_MAX_REDIRECTS=3
AI_ALLOW_CROSS_ORIGIN_REDIRECTS=false

# Healing readiness/cache safety.
HEALING_PRIMARY_READY_TIMEOUT_MS=1500
HEALING_RECOVERY_READY_TIMEOUT_MS=400
HEALING_CACHE_TTL_MS=604800000
HEALING_CACHE_LOCK_TIMEOUT_MS=2000
HEALING_CACHE_STALE_LOCK_MS=30000

# Shared trend/duration history is environment-scoped and lock-merged for concurrent runs.
REPORT_HISTORY_LOCK_TIMEOUT_MS=2000
REPORT_HISTORY_STALE_LOCK_MS=30000
DURATION_HISTORY_LOCK_TIMEOUT_MS=2000
DURATION_HISTORY_STALE_LOCK_MS=30000
