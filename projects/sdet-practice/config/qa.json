{
  "environment": "qa",
  "application": {
    "name": "SDET Practice User Management",
    "uiBaseUrl": "https://sdet-practice-app.onrender.com",
    "apiBaseUrl": "https://sdet-practice-app.onrender.com"
  },
  "auth": {
    "strategy": "storageState",
    "storageStatePath": ".auth/sdet-practice.exploration.json",
    "required": true,
    "verification": {
      "stateKey": {
        "name": "sdet_access_token",
        "storage": "either"
      },
      "settleMs": 400,
      "timeoutMs": 2500
    },
    "lifecycle": {
      "autoRefresh": true,
      "providerModule": "auth/auth.provider.ts",
      "verifyBeforeRun": true,
      "refreshSkewMs": 120000,
      "maxRefreshAttempts": 2,
      "runtimeRecovery": "navigation",
      "maxRuntimeRefreshes": 1,
      "lockTimeoutMs": 30000,
      "lockStaleMs": 120000
    }
  },
  "capabilities": {
    "database": {
      "type": "none"
    }
  }
}
