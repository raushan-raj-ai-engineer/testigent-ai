# Gemini single-provider example (local or CI)
AI_ENABLED=true
AI_PROVIDER_MODE=single
AI_PROVIDER=gemini
AI_ALLOW_CLOUD_EGRESS=true
AI_ALLOWED_EXTERNAL_ORIGINS=https://generativelanguage.googleapis.com
HEALING_AI_ENABLED=true
HEALING_MODE=runtime

# Inject the key from local .env or a CI secret store. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Print actual provider/model/status/latency for AI calls
AI_RUNTIME_LOGGING=true
