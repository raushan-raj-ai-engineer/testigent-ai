# Add these to your existing .env; do not replace real environment-specific values blindly.

# Execution scale
PW_WORKERS=4
PW_RETRIES=1
PW_MAX_FAILURES=50
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000

# AI governance
AI_ENABLED=false
# Explicitly enable and select one provider when AI is required.
AI_PROVIDER_MODE=single
AI_PROVIDER=
# For failover mode, define exact order, e.g. ollama,gemini or gemini,openai.
AI_PROVIDER_ORDER=
AI_ALLOW_CLOUD_EGRESS=false
AI_ALLOWED_EXTERNAL_ORIGINS=
AI_MAX_HEALING_CALLS_PER_TEST=2
AI_MAX_REPORT_CALLS_PER_RUN=1
AI_TIMEOUT_MS=30000
HEALING_AI_ENABLED=true
HEALING_MODE=runtime
HEALING_MIN_CONFIDENCE=0.95

# Optional cloud provider use requires AI_ALLOW_CLOUD_EGRESS=true.
