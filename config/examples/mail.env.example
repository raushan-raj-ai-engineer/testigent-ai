# Interactive business dashboard
BUSINESS_PASS_THRESHOLD=95
REPORT_HISTORY_ENABLED=true
REPORT_HISTORY_MAX_RUNS=30
REPORT_HISTORY_FILE=.report-history/business-history.json
# Public CI artifact/dashboard URL. If blank, email attaches the HTML report instead.
REPORT_PUBLIC_URL=

# Mail notification
# preview = create reports/notifications/*.eml without sending
# smtp    = send through your organization's SMTP relay/provider
MAIL_MODE=preview
MAIL_FROM=automation-reports@example.com
MAIL_TO=business-team@example.com
MAIL_CC=
MAIL_SUBJECT_PREFIX=[Enterprise Automation]
MAIL_ATTACH_REPORT=true
MAIL_ATTACH_JSON=false
MAIL_VERIFY_CONNECTION=false
NOTIFICATION_STRICT=false

# SMTP only (MAIL_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000


# Additional mail options
# Business email delivery
# preview = writes reports/notifications/*.eml and never sends
# smtp    = real SMTP delivery
MAIL_MODE=preview
MAIL_FROM=automation-reports@example.com
MAIL_TO=business-team@example.com
MAIL_CC=
MAIL_BCC=
MAIL_REPLY_TO=
MAIL_SUBJECT_PREFIX=[Enterprise Automation]
# always | attention | passed
MAIL_NOTIFY_ON=always
NOTIFICATION_STRICT=false

# Preferred: publish the V3 dashboard and put this URL in the email.
REPORT_PUBLIC_URL=

# V3-safe attachments
MAIL_ATTACH_STATIC_REPORT=true
MAIL_ATTACH_CSV=true
MAIL_ATTACH_EXECUTIVE_SUMMARY=false
MAIL_ATTACH_JSON=false
MAIL_PREVIEW_DIR=reports/notifications
# false = keep only latest-business-report.eml at top level; true = also keep run archives under reports/notifications/archive/
MAIL_PREVIEW_ARCHIVE=false

# SMTP settings (only for MAIL_MODE=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_SERVERNAME=
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=30000
MAIL_VERIFY_CONNECTION=false
