# Core CI business reporting
ENV=qa
APP=demo

# Dashboard is always generated as a CI artifact.
# GitHub only: set true to deploy the latest merged dashboard to GitHub Pages.
BUSINESS_DASHBOARD_PUBLISH_PAGES=false
REPORT_PUBLIC_URL=

# Mail is fully optional. Missing/false means no SMTP connection is attempted.
BUSINESS_EMAIL_ENABLED=false
NOTIFICATION_STRICT=false
MAIL_NOTIFY_ON=always

# Only required when BUSINESS_EMAIL_ENABLED=true
MAIL_FROM=
MAIL_TO=
MAIL_CC=
MAIL_BCC=
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_ATTACH_STATIC_REPORT=true
MAIL_ATTACH_CSV=true
MAIL_ATTACH_JSON=false
MAIL_ATTACH_EXECUTIVE_SUMMARY=false


# Optional AI execution - disabled unless explicitly enabled by the pipeline/user.
AI_ENABLED=false
AI_PROVIDER_MODE=single
AI_PROVIDER=
AI_PROVIDER_ORDER=
AI_ALLOW_CLOUD_EGRESS=false
HEALING_AI_ENABLED=false
HEALING_MODE=suggest

# Example Gemini CI non-secret setting; inject GEMINI_API_KEY from the CI secret store.
GEMINI_MODEL=

# Other provider model/endpoint values can be injected as CI variables.
OPENAI_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=
ANTHROPIC_MODEL=
AI_COMPAT_BASE_URL=
AI_COMPAT_MODEL=
AI_ENDPOINT=
AI_MODEL=
