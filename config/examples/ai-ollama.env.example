# Ollama single-provider example (local/private execution)
AI_ENABLED=true
AI_PROVIDER_MODE=single
AI_PROVIDER=ollama
AI_ALLOW_CLOUD_EGRESS=false
HEALING_AI_ENABLED=true
HEALING_MODE=runtime

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Print actual provider/model/status/latency for AI calls
AI_RUNTIME_LOGGING=true
