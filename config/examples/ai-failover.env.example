# Explicit failover example. Every listed provider must be fully configured.
AI_ENABLED=true
AI_PROVIDER_MODE=failover
AI_PROVIDER_ORDER=ollama,gemini
AI_ALLOW_CLOUD_EGRESS=true
AI_ALLOWED_EXTERNAL_ORIGINS=https://generativelanguage.googleapis.com
HEALING_AI_ENABLED=true
HEALING_MODE=runtime

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Print actual provider/model/status/latency for AI calls
AI_RUNTIME_LOGGING=true
