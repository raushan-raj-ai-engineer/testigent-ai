# External Requirement / Project-Management Connectors
# Author: Raushan Raj

# Generic HTTP resilience
CONNECTOR_TIMEOUT_MS=15000
CONNECTOR_MAX_RETRIES=2
CONNECTOR_RETRY_BACKOFF_MS=250
CONNECTOR_MAX_BACKOFF_MS=5000

# Write-back remains independently gated by the existing feature flag.
EXECUTION_STATUS_PUBLISH_ENABLED=false
EXECUTION_STATUS_PUBLISH_TARGET=
EXECUTION_PUBLISH_DEDUPLICATE=true
EXTERNAL_PUBLISH_DRY_RUN=false
ALLOW_EXTERNAL_COMMENTS=true
ALLOW_EXTERNAL_CUSTOM_FIELDS=false
ALLOW_WORKFLOW_TRANSITIONS=false

# Jira Cloud ---------------------------------------------------------------
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_BEARER_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_ALLOW_ANONYMOUS_READ=false
# Optional custom fields; e.g. customfield_12345
JIRA_ACCEPTANCE_CRITERIA_FIELD_ID=
JIRA_MANUAL_STEPS_FIELD_ID=
JIRA_AUTOMATION_STATUS_FIELD_ID=
JIRA_AUTOMATION_STATUS_FIELD_MODE=string
JIRA_AUTOMATION_STATUS_VALUE_PASSED=PASSED
JIRA_AUTOMATION_STATUS_VALUE_FAILED=FAILED
# Transitions are never used unless ALLOW_WORKFLOW_TRANSITIONS=true.
JIRA_TRANSITION_PASSED_ID=
JIRA_TRANSITION_FAILED_ID=

# Azure Boards -------------------------------------------------------------
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=YourProject
# Prefer an Entra/service-principal/managed-identity access token for durable automation.
AZURE_DEVOPS_ACCESS_TOKEN=
# PAT remains supported for local/scripts when needed.
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_API_VERSION=7.1
AZURE_DEVOPS_COMMENTS_API_VERSION=7.1-preview.4
AZURE_DEVOPS_DESCRIPTION_FIELD=System.Description
AZURE_DEVOPS_ACCEPTANCE_CRITERIA_FIELD=Microsoft.VSTS.Common.AcceptanceCriteria
AZURE_DEVOPS_MANUAL_STEPS_FIELD=
AZURE_DEVOPS_AUTOMATION_STATUS_FIELD=
AZURE_DEVOPS_AUTOMATION_STATUS_VALUE_PASSED=PASSED
AZURE_DEVOPS_AUTOMATION_STATUS_VALUE_FAILED=FAILED
AZURE_DEVOPS_STATE_PASSED=
AZURE_DEVOPS_STATE_FAILED=

# GitHub Issues ------------------------------------------------------------
GITHUB_REQUIREMENT_REPO=owner/repo
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_ALLOW_PULL_REQUEST_SOURCE=false
GITHUB_STATUS_LABEL_PREFIX=automation
GITHUB_AUTOMATION_STATUS_VALUE_PASSED=passed
GITHUB_AUTOMATION_STATUS_VALUE_FAILED=failed
GITHUB_STATE_PASSED=
GITHUB_STATE_FAILED=
