# Application Knowledge & Learning V1
# Author: Raushan Raj

# All exploration/learning capabilities are OFF unless explicitly enabled.
APPLICATION_EXPLORATION_ENABLED=false
APP=
APP_BASE_URL=
ENV=qa

# Safety boundary
EXPLORATION_ALLOWED_ENVIRONMENTS=dev,qa,test,staging
EXPLORATION_ALLOWED_ORIGINS=
EXPLORATION_MAX_PAGES=20
EXPLORATION_MAX_DEPTH=4
EXPLORATION_NAVIGATION_TIMEOUT_MS=15000
EXPLORATION_CAPTURE_VISIBLE_TEXT=true

# Authentication: defaults to .auth/<APP>.exploration.json
# Keep .auth/ out of Git because storage state can contain session cookies/tokens.
EXPLORATION_STORAGE_STATE=

# Guided learning
EXPLORATION_JOURNEY_NAME=

# Requirement/generation controls remain separate.
REQUIREMENT_INTELLIGENCE_ENABLED=false
TEST_GENERATION_ENABLED=false
TEST_GENERATION_REFRESH_PROPOSALS=false
