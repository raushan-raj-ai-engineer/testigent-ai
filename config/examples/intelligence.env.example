# Requirement Intelligence + Application Knowledge
# Author: Raushan Raj
REQUIREMENT_INTELLIGENCE_ENABLED=false
APPLICATION_EXPLORATION_ENABLED=false
TEST_GENERATION_ENABLED=false
EXECUTION_STATUS_PUBLISH_ENABLED=false
EXECUTION_STATUS_PUBLISH_TARGET=
ALLOW_EXTERNAL_COMMENTS=true
ALLOW_EXTERNAL_CUSTOM_FIELDS=false
ALLOW_WORKFLOW_TRANSITIONS=false

# Target application / exploration
APP=
APP_BASE_URL=
EXPLORATION_ALLOWED_ENVIRONMENTS=dev,qa,test,staging
EXPLORATION_ALLOWED_ORIGINS=
EXPLORATION_MAX_PAGES=20
EXPLORATION_MAX_DEPTH=4
EXPLORATION_NAVIGATION_TIMEOUT_MS=15000
EXPLORATION_CAPTURE_VISIBLE_TEXT=true
EXPLORATION_STORAGE_STATE=
EXPLORATION_JOURNEY_NAME=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_AUTOMATION_STATUS_FIELD_ID=
JIRA_TRANSITION_ID=

# Azure Boards
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
AZURE_DEVOPS_AUTOMATION_STATUS_FIELD=

# GitHub Issues
GITHUB_REQUIREMENT_REPO=owner/repo
# GITHUB_TOKEN should come from secret storage / GitHub Actions runtime
